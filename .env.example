# Discord Developer Portal -> OAuth2 / General
DISCORD_CLIENT_ID=your_application_client_id
DISCORD_CLIENT_SECRET=your_application_client_secret

# Discord Developer Portal -> Bot -> Reset Token
# NEVER put this in NEXT_PUBLIC_* or commit the real value.
DISCORD_BOT_TOKEN=your_bot_token

# Public production origin. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random 32+ character secret used to encrypt the login session cookie.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
